{
  "name": "vibelens-mcp",
  "version": "0.1.0",
  "description": "VibeLens MCP tool for AI to visualize code changes with inline annotations in VS Code/Cursor",
  "type": "module",
  "main": "dist/index.js",
  "mcpName": "io.github.klewicki7/vibelens-mcp",
  "author": "Kevin Lewicki <kevin@flexways.com>",
  "license": "MIT",
  "contributors": [
    "Vlad Tansky (original explain-changes-mcp)"
  ],
  "homepage": "https://github.com/klewicki7/VibeLens#readme",
  "bugs": {
    "url": "https://github.com/klewicki7/VibeLens/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klewicki7/VibeLens.git",
    "directory": "packages/mcp"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "vibelens-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "vibelens",
    "ai",
    "diff",
    "vscode",
    "cursor"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^12.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=18"
  }
}
