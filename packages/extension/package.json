{
  "name": "vibelens-extension",
  "displayName": "VibeLens",
  "description": "VibeLens — AI peer review for your code changes",
  "version": "0.1.0",
  "publisher": "kevcode",
  "license": "MIT",
  "author": "Kevin Lewicki <kevin@flexways.com>",
  "contributors": [
    "Vlad Tansky (original explain-changes-mcp)"
  ],
  "homepage": "https://github.com/klewicki7/VibeLens#readme",
  "bugs": {
    "url": "https://github.com/klewicki7/VibeLens/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klewicki7/VibeLens.git",
    "directory": "packages/extension"
  },
  "keywords": [
    "ai",
    "code-review",
    "cursor",
    "diff",
    "mcp",
    "vibelens"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vibelens.showPanel",
        "title": "VibeLens: Show Panel"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node && pnpm run copy:wasm",
    "copy:wasm": "node scripts/copy-wasm.mjs",
    "compile": "pnpm run build",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --watch",
    "dev": "node dev/server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npx @vscode/vsce package --allow-missing-repository --no-dependencies",
    "publish:vscode": "npx @vscode/vsce publish",
    "publish:open-vsx": "npx ovsx publish"
  },
  "dependencies": {
    "diff2html": "^3.4.56",
    "smol-toml": "^1.6.1",
    "sql.js": "^1.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/sql.js": "^1.4.9",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.7"
  }
}
