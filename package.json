{
  "name": "explain-changes",
  "version": "2.0.0",
  "private": true,
  "description": "Visualize code changes with AI-generated annotations in VS Code/Cursor",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build",
    "build:mcp": "pnpm --filter explain-changes-mcp build",
    "build:extension": "pnpm --filter explain-changes-extension compile"
  },
  "author": "Kevin Lewicki <kevin@flexways.com>",
  "license": "MIT",
  "contributors": [
    "Vlad Tansky (original explain-changes-mcp)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/klewicki7/VibeLens.git"
  }
}
